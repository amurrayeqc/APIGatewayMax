{
  "port": 8080,
  "routes": [
    {
      "prefix": "/api",
      "upstreams": ["http://127.0.0.1:4001", "http://127.0.0.1:4002"],
      "stripPrefix": true,
      "timeoutMs": 5000,
      "retries": 1,
      "failureThreshold": 3,
      "cooldownMs": 30000,
      "rateLimit": { "max": 100, "windowMs": 60000 }
    }
  ]
}
